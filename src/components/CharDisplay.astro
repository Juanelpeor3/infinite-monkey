---
import WordSearch from "./WordSearch.astro";
import { translations, type Lang } from "../i18n/translations";

interface Props {
    chars?: string;
    total?: number;
    charsId?: string;
    badgeId?: string;
    lang?: Lang;
}

const {
    chars,
    total,
    charsId = "allChars",
    badgeId = "charBadge",
    lang = "es",
} = Astro.props;

const safeLang = (lang ?? "es") as Lang;
const t = translations[safeLang].charDisplay;
const isStatic = chars !== undefined;

function escapeHtml(str: string) {
    return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
}
---

<div class="flex-1 flex flex-col min-h-0 gap-2">
    <div class="shrink-0 flex items-center justify-between">
        <h2
            class="text-sm sm:text-base text-[#333] font-semibold font-sans uppercase tracking-wider"
        >
            {t.title}
        </h2>
        {
            isStatic ? (
                <span class="text-xs font-sans bg-[#8b6f47] text-white px-3 py-1 rounded-full">
                    {total?.toLocaleString()}
                </span>
            ) : (
                <span
                    id={badgeId}
                    class="text-xs font-sans bg-[#8b6f47] text-white px-3 py-1 rounded-full"
                >
                    0
                </span>
            )
        }
    </div>

    {
        isStatic ? (
            <WordSearch lang={safeLang} />
        ) : (
            <WordSearch sourceId={charsId} lang={safeLang} />
        )
    }

    {
        isStatic ? (
            total === 0 ? (
                <div class="flex-1 min-h-0 bg-[#1e1e1e] text-[#666] px-4 sm:px-6 py-4 rounded-lg font-mono flex items-center justify-center text-center">
                    {t.noChars}
                </div>
            ) : (
                <pre
                    id="word-search-output"
                    data-chars={chars}
                    class="flex-1 min-h-0 overflow-y-auto bg-[#1e1e1e] text-[#d4d4d4] px-4 sm:px-6 py-4 rounded-lg text-sm sm:text-base font-mono whitespace-pre-wrap leading-relaxed"
                    set:html={escapeHtml(chars!)}
                />
            )
        ) : (
            <>
                <pre
                    id="word-search-highlight"
                    style="display:none"
                    class="flex-1 min-h-0 overflow-y-auto bg-[#1e1e1e] text-[#d4d4d4] px-4 sm:px-6 py-4 rounded-lg text-sm sm:text-base font-mono whitespace-pre-wrap leading-relaxed"
                />
                <pre
                    id={charsId}
                    aria-label="All generated characters"
                    class="flex-1 min-h-0 overflow-y-auto bg-[#1e1e1e] text-[#d4d4d4] px-4 sm:px-6 py-4 rounded-lg text-sm sm:text-base font-mono whitespace-pre-wrap leading-relaxed"
                />
            </>
        )
    }
</div>
