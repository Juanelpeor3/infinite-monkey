---
import data from "../data/monkey-bot.json";
import CharDisplay from "./CharDisplay.astro";
import { translations, type Lang } from "../i18n/translations";

interface Props {
    lang?: Lang;
}

const { lang = "es" } = Astro.props;
const safeLang = (lang ?? "es") as Lang;
const t = translations[safeLang].monkeyBot;
const tNav = translations[safeLang].nav;
const dateLocale = safeLang === "es" ? "es-ES" : "en-GB";

const { chars, total, lastUpdated } = data;
const words = chars
    .trim()
    .split(/[\s\n]+/)
    .filter((w: string) => w.length > 0).length;
const formattedTotal = total.toLocaleString(dateLocale);
const formattedWords = words.toLocaleString(dateLocale);
const lastUpdatedFormatted = lastUpdated
    ? new Date(lastUpdated).toLocaleString(dateLocale, {
          dateStyle: "medium",
          timeStyle: "short",
      })
    : t.never;
---

<div
    class="flex-1 flex flex-col overflow-hidden min-h-0 px-4 sm:px-6 py-2 max-w-4xl mx-auto w-full"
>
    <div class="shrink-0 text-center mb-2">
        <h1
            class="text-2xl sm:text-3xl text-[#1a1a1a] tracking-tight font-serif"
        >
            {t.title}
        </h1>
        <p class="text-[#8b6f47] font-sans text-xs tracking-widest uppercase">
            {t.subtitle}
        </p>
    </div>

    <div
        class="flex-1 flex flex-col min-h-0 rounded-xl overflow-hidden border border-[#d5c8b5] shadow-lg"
    >
        <div
            class="shrink-0 bg-[#3d2b1a] px-4 sm:px-6 py-3 sm:py-4 flex flex-wrap items-center gap-5 sm:gap-8"
        >
            <div>
                <p
                    class="text-[10px] uppercase tracking-widest text-[#dbd3c9] mb-0.5 font-sans"
                >
                    {t.totalChars}
                </p>
                <p
                    class="text-2xl sm:text-3xl font-mono text-white leading-none"
                >
                    {formattedTotal}
                </p>
            </div>
            <div>
                <p
                    class="text-[10px] uppercase tracking-widest text-[#dbd3c9] mb-0.5 font-sans"
                >
                    {t.words}
                </p>
                <p
                    class="text-2xl sm:text-3xl font-mono text-white leading-none"
                >
                    {formattedWords}
                </p>
            </div>
            <div class="sm:ml-auto">
                <p
                    class="text-[10px] uppercase tracking-widest text-[#dbd3c9] mb-0.5 font-sans"
                >
                    {t.lastUpdated}
                </p>
                <p class="text-sm font-mono text-white/80">
                    {lastUpdatedFormatted}
                </p>
            </div>
        </div>

        <div class="flex-1 flex flex-col min-h-0 bg-white px-4 sm:px-6 py-3">
            <CharDisplay chars={chars} total={total} lang={safeLang} />
        </div>
    </div>

    <div class="shrink-0 text-center py-2">
        <p class="text-[10px] font-sans text-[#b0926a] mb-1 leading-relaxed">
            {t.footer}
        </p>
        <a
            href={safeLang === "en" ? "/en" : "/"}
            class="text-xs font-sans text-[#b0926a] hover:text-[#8b6f47] transition-colors"
        >
            {tNav.back}
        </a>
    </div>
</div>
