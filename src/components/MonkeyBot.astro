---
import data from "../data/monkey-bot.json";
import CharDisplay from "./CharDisplay.astro";
import { translations, type Lang } from "../i18n/translations";

interface Props {
    lang?: Lang;
}

const { lang = "es" } = Astro.props;
const safeLang = (lang ?? "es") as Lang;
const t = translations[safeLang].monkeyBot;
const dateLocale = safeLang === "es" ? "es-ES" : "en-GB";

const { chars, total, lastUpdated } = data;
const words = chars
    .trim()
    .split(/[\s\n]+/)
    .filter((w: string) => w.length > 0).length;
const lastUpdatedFormatted = lastUpdated
    ? new Date(lastUpdated).toLocaleString(dateLocale, {
          dateStyle: "medium",
          timeStyle: "short",
      })
    : t.never;
---

<div
    class="max-w-2xl mx-auto mt-8 sm:mt-14 px-4 sm:px-6 font-serif text-[#222]"
>
    <div class="text-center mb-7 sm:mb-9">
        <h1
            class="text-3xl sm:text-4xl md:text-5xl text-[#1a1a1a] tracking-tight mb-2"
        >
            {t.title}
        </h1>
        <p
            class="text-[#8b6f47] font-sans text-xs sm:text-sm tracking-widest uppercase"
        >
            {t.subtitle}
        </p>
    </div>

    <!-- Stat cards -->
    <div class="grid grid-cols-2 gap-3 sm:gap-4 mb-3 sm:mb-4">
        <div
            class="bg-white rounded-xl border border-[#d5c8b5] px-5 py-4 sm:px-6 sm:py-5 shadow-sm"
        >
            <p
                class="text-[10px] sm:text-xs uppercase tracking-widest text-[#8b6f47] mb-1.5 font-sans"
            >
                {t.totalChars}
            </p>
            <p
                class="text-2xl sm:text-3xl font-mono text-[#1a1a1a] leading-none"
            >
                {total}
            </p>
        </div>
        <div
            class="bg-white rounded-xl border border-[#d5c8b5] px-5 py-4 sm:px-6 sm:py-5 shadow-sm"
        >
            <p
                class="text-[10px] sm:text-xs uppercase tracking-widest text-[#8b6f47] mb-1.5 font-sans"
            >
                {t.words}
            </p>
            <p
                class="text-2xl sm:text-3xl font-mono text-[#1a1a1a] leading-none"
            >
                {words}
            </p>
        </div>
    </div>

    <!-- Last updated strip -->
    <div
        class="bg-white rounded-xl border border-[#d5c8b5] px-5 py-3.5 mb-4 flex items-center justify-between shadow-sm"
    >
        <p
            class="text-[10px] sm:text-xs uppercase tracking-widest text-[#8b6f47] font-sans"
        >
            {t.lastUpdated}
        </p>
        <p class="font-mono text-sm text-[#1a1a1a]">{lastUpdatedFormatted}</p>
    </div>

    <!-- Character display card -->
    <div
        class="bg-white rounded-2xl border border-[#d5c8b5] shadow-lg overflow-hidden"
    >
        <div class="px-5 sm:px-7 py-5">
            <CharDisplay
                chars={chars}
                total={total}
                lang={safeLang}
                fullWidth
            />
        </div>
    </div>

    <!-- Footer note -->
    <p
        class="mt-5 text-xs font-sans text-[#b0926a] leading-relaxed text-center"
    >
        {t.footer}
    </p>
</div>
